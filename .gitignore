# Editor backups and temporary files
.*,
*~
*.autosave
*.swp
*.orig
temp_*
Thumbs.db
desktop.ini
.DS_Store

# IDEs and tools
.idea
.qtcreator
.vs
.vscode/
.cache
.claude/
**/.qmlls.ini
compile_commands.json

# Local build settings
/build_overrides.cmake
*.local.cmake
*.user
CMakeLists.txt.user.*
CMakeUserPresets.json
/buildscripts/cmake/SetupBuildEnvironment.user.cmake
local_build_revision.env

# Build output: every build.* folder (build.release, build.install ...); build.cmake is a file and stays tracked
/build.*/
/builds
build
build-*
/msvc.*
/dist/
/out/
/scratch/

# Dependencies downloaded at configure time
**/_deps/*
# prebuilt Windows libraries unpacked into the source tree
/dependencies/


# Translations: compiled catalogues and placeholder files are generated by the build
/share/locale/*.qm
/share/locale/*placeholder.ts

# Generated instrument data
/share/instruments/tsv

# Python
__pycache__/
*.pyc
.venv/
venv/
.pdm-python
*.egg-info/

# Drum model: training checkpoints and data stay outside the repository; only the shipped model is tracked
*.pt
!/share/ai/kitnote_drums.pt
/tools/kitnote/data/

# Private notes and reports (they may name the owner's own recordings)
/reports/

# Generated by tools/kitnote/make_drum_soundfont.py (CI and buildscripts/ci/macos/build.sh make it before the build)
/share/sound/KitNote Drums.sf3
