// KitNote: the version shown in the executable's file properties and in Task Manager.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @KITNOTE_APP_VERSION_MAJOR@,@KITNOTE_APP_VERSION_MINOR@,@KITNOTE_APP_VERSION_PATCH@,0
PRODUCTVERSION  @KITNOTE_APP_VERSION_MAJOR@,@KITNOTE_APP_VERSION_MINOR@,@KITNOTE_APP_VERSION_PATCH@,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "KitNote"
            VALUE "FileDescription",  "@KITNOTE_APP_NAME_HUMAN_READABLE@"
            VALUE "FileVersion",      "@KITNOTE_APP_VERSION@"
            VALUE "InternalName",     "@KITNOTE_APP_NAME_MACHINE_READABLE@"
            VALUE "LegalCopyright",   "Copyright (C) 1999-2026 MuseScore Limited and others. GNU General Public License version 3."
            VALUE "OriginalFilename", "@KITNOTE_APP_NAME_MACHINE_READABLE@.exe"
            VALUE "ProductName",      "@KITNOTE_APP_NAME_HUMAN_READABLE@"
            VALUE "ProductVersion",   "@KITNOTE_APP_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
